# Local development. libSQL reads plain SQLite files, so this is the same
# driver production uses, pointed at a file.
DATABASE_URL="file:./prisma/dev.db"

# Production (Turso). Set both in Vercel; leave them unset locally.
# When TURSO_DATABASE_URL is present it wins over DATABASE_URL.
# TURSO_DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN=""

# The origin used for canonical URLs, the sitemap and Open Graph tags.
# Without it the value in src/config/directory.ts is used, which is what
# makes a preview deployment claim to be production. Set it per environment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
